<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrintTool.Client.UI</AssemblyName>

    <!--
      Publica direto na mesma pasta do PrintTool.Client (o Windows Service) — não numa pasta
      própria. Ver o comentário equivalente em PrintTool.Host.UI.csproj: sem isso, cada um
      acabaria com seu próprio printers.json/security, divergentes entre si.
    -->
    <PublishDir>$(MSBuildThisFileDirectory)..\PrintTool.Client\bin\$(Configuration)\$(TargetFramework)\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintTool.Client\PrintTool.Client.csproj" />
    <ProjectReference Include="..\PrintTool.Ui.Shared\PrintTool.Ui.Shared.csproj" />
  </ItemGroup>

</Project>
