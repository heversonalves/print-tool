<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ícones simples em geometria de caminho (grid 24x24), sem pacote externo.
        Convenção: ícones de contorno (shield, chevron, copy, refresh, x-circle, check-circle)
        são pensados pra uso com Stroke; o printer é pensado pra uso com Fill.
    -->

    <GeometryGroup x:Key="IconPrinter" FillRule="Nonzero">
        <RectangleGeometry Rect="6,2,12,5" RadiusX="1.5" RadiusY="1.5" />
        <RectangleGeometry Rect="2,7,20,10" RadiusX="2.5" RadiusY="2.5" />
        <RectangleGeometry Rect="6,15,12,7" RadiusX="1.5" RadiusY="1.5" />
        <EllipseGeometry Center="17,11" RadiusX="1" RadiusY="1" />
    </GeometryGroup>

    <PathGeometry x:Key="IconShield">M12,2 L19,5 L19,11 C19,16 15.9,20 12,21.5 C8.1,20 5,16 5,11 L5,5 Z</PathGeometry>

    <PathGeometry x:Key="IconCheck">M7,12.5 L10.3,16 L17,8.5</PathGeometry>

    <EllipseGeometry x:Key="IconCircleOutline" Center="12,12" RadiusX="9" RadiusY="9" />

    <PathGeometry x:Key="IconXMark">M8,8 L16,16 M16,8 L8,16</PathGeometry>

    <PathGeometry x:Key="IconChevronRight">M9,5 L16,12 L9,19</PathGeometry>

    <GeometryGroup x:Key="IconCopy" FillRule="Nonzero">
        <RectangleGeometry Rect="3.5,3.5,13,13" RadiusX="2" RadiusY="2" />
        <RectangleGeometry Rect="7.5,7.5,13,13" RadiusX="2" RadiusY="2" />
    </GeometryGroup>

    <PathGeometry x:Key="IconRefresh">
        M18.5,6.5 A8,8 0 1 0 20,13 M18.5,6.5 L18.5,2.5 M18.5,6.5 L22.2,6.5
    </PathGeometry>

</ResourceDictionary>
