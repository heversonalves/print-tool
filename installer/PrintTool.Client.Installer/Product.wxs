<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Instalador do PrintTool Client: leva o runtime do .NET embutido (publish self-contained, ver
    PrintTool.Client.csproj) — a máquina não precisa ter nada instalado antes — e cuida do que os
    scripts scripts\install-client.ps1/uninstall-client.ps1 faziam na mão: registra o Windows
    Service, inicia ele, e cria o atalho do app de administração (PrintTool.Client.UI) no Menu
    Iniciar. Desinstalar (pelo Painel de Controle) para o serviço e remove tudo, exceto
    "printers.json" e a pasta "security\" — ver <Component Id="Comp_KeepUserData"> abaixo.
  -->
  <Package Name="PrintTool Client"
           Manufacturer="PrintTool"
           Version="1.0.0"
           UpgradeCode="2e9d5ef3-a89d-4066-a6b2-c3a844e57035"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais nova do PrintTool Client instalada." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PrintTool Client" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="PrintTool" />
    </StandardDirectory>

    <!--
      Todo o conteúdo publicado (DLLs do runtime embutido, appsettings.json, etc.), exceto o
      próprio PrintTool.Client.exe — esse ganha um Component dedicado abaixo, porque precisa
      estar junto do <ServiceInstall>/<ServiceControl> dele.
    -->
    <ComponentGroup Id="PublishFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\PrintTool.Client.exe" />
      </Files>
    </ComponentGroup>

    <Component Directory="INSTALLFOLDER" Id="Comp_ClientService">
      <File Id="ClientExe" Source="$(var.PublishDir)/PrintTool.Client.exe" KeyPath="yes" />

      <ServiceInstall Id="ClientServiceInstall"
                       Name="PrintTool.Client"
                       DisplayName="Print Tool - Client"
                       Description="Encaminha jobs de impressão para o Host do Print Tool na rede local."
                       Type="ownProcess"
                       Start="auto"
                       ErrorControl="normal"
                       Account="LocalSystem" />

      <ServiceControl Id="ClientServiceControl"
                       Name="PrintTool.Client"
                       Start="install"
                       Stop="both"
                       Remove="uninstall"
                       Wait="yes" />
    </Component>

    <!--
      Dados da pessoa (identidade do Client, tokens dos Hosts pareados, mapeamento de
      impressoras) não podem sumir num upgrade/reinstalação — mesma lógica do instalador do
      Host, ver o comentário equivalente lá.
    -->
    <Component Directory="INSTALLFOLDER" Permanent="yes" Id="Comp_KeepUserData">
      <CreateFolder Directory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\PrintTool\Client" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Directory="ShortcutFolder" Id="Comp_StartMenuShortcut">
      <Shortcut Id="ClientUiShortcut"
                Name="PrintTool Client"
                Description="Conectar esta máquina a impressoras compartilhadas na rede"
                Target="[INSTALLFOLDER]PrintTool.Client.UI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\PrintTool\Client" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="PrintTool Client" Level="1">
      <ComponentGroupRef Id="PublishFiles" />
      <ComponentRef Id="Comp_ClientService" />
      <ComponentRef Id="Comp_KeepUserData" />
      <ComponentRef Id="Comp_StartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>
</Wix>
